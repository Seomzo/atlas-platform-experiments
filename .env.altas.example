# Altas local prototype only. Do not put production credentials in this file.
ALTAS_DATABASE_PATH=data/altas-control-plane.sqlite3
ALTAS_LEASE_SIGNING_KEY=altas-demo-signing-key-change-me-00000001
ALTAS_ADMIN_TOKEN=altas-demo-admin-token-v1
ALTAS_SEED_DEMO_DATA=true
ALTAS_MODEL_MOCK=true
ALTAS_LEASE_TTL_SECONDS=300
ALTAS_JOB_VISIBILITY_TIMEOUT_SECONDS=900
ALTAS_MAX_MODEL_REQUESTS_PER_JOB=8
ALTAS_MAX_REQUESTED_TOKENS_PER_JOB=4096
ALTAS_DEFAULT_MODEL_MAX_TOKENS=400

# Seeded worker identity. The demo value is public and has no external access.
# Do not set ALTAS_MANAGED_MODE here. The Altas provider enables it only when
# selected, after a worker supervisor has injected the current ALTAS_LEASE_TOKEN,
# ALTAS_JOB_ID, and ALTAS_CLAIM_TOKEN for the claimed job. Static managed mode
# without that dynamic context intentionally fails closed.
ALTAS_CONTROL_PLANE_URL=http://127.0.0.1:8787
ALTAS_DEVICE_ID=device_demo_local_worker
ALTAS_DEVICE_TOKEN=altas-demo-device-secret-v1
ALTAS_TENANT_ID=tenant_demo_fixed_ops
ALTAS_STORE_ID=store-sunrise-vw
ALTAS_AGENT_ID=agent_demo_altas

# Production gateway configuration is intentionally unset.
# ALTAS_UPSTREAM_BASE_URL=https://api.openai.com/v1
# ALTAS_UPSTREAM_API_KEY=
