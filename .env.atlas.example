# Atlas local prototype only. Do not put production credentials in this file.
ATLAS_DATABASE_PATH=data/atlas-control-plane.sqlite3
ATLAS_LEASE_SIGNING_KEY=atlas-demo-signing-key-change-me-00000001
ATLAS_ADMIN_TOKEN=atlas-demo-admin-token-v1
ATLAS_SEED_DEMO_DATA=true
ATLAS_MODEL_MOCK=true
ATLAS_LEASE_TTL_SECONDS=300
ATLAS_MANAGED_APPROVAL_TTL_SECONDS=120
ATLAS_JOB_VISIBILITY_TIMEOUT_SECONDS=900
# A claimed session-end Cortex batch gets this job-bound lease; it must remain
# shorter than the visibility timeout and cover the bounded 20-call route.
ATLAS_CORTEX_JOB_LEASE_TTL_SECONDS=840
ATLAS_MAX_MODEL_REQUESTS_PER_JOB=8
ATLAS_MAX_REQUESTED_TOKENS_PER_JOB=4096
# Dedicated bounded budget for session-end triage batches, one repair per batch,
# and the same maximum reviewed-call path. It is not shared with chat jobs.
ATLAS_CORTEX_MAX_MODEL_REQUESTS_PER_JOB=20
ATLAS_CORTEX_MAX_REQUESTED_TOKENS_PER_JOB=80000
# Server-side admission: one active Cortex job and at most this many new or
# requeued dispatches per authenticated device/profile in a rolling 24-hour window.
ATLAS_CORTEX_MAX_JOBS_PER_DEVICE_PER_24H=24
ATLAS_DEFAULT_MODEL_MAX_TOKENS=400
# Stable product alias for Cortex's dedicated low-cost structured-output route.
ATLAS_CORTEX_MODEL_ID=atlas-cortex-memory

# Seeded worker identity. The demo value is public and has no external access.
# Do not set ATLAS_MANAGED_MODE here. The authenticated worker installs it only
# inside the current job's context-local scope, together with the lease, job,
# capability, and claim. Static managed mode without that dynamic context
# intentionally fails closed.
ATLAS_CONTROL_PLANE_URL=http://127.0.0.1:8787
ATLAS_DEVICE_ID=device_demo_local_worker
ATLAS_DEVICE_TOKEN=atlas-demo-device-secret-v1
ATLAS_TENANT_ID=tenant_demo_fixed_ops
ATLAS_STORE_ID=store-sunrise-vw
ATLAS_AGENT_ID=agent_demo_atlas

# Production gateway configuration is intentionally unset.
# ATLAS_UPSTREAM_BASE_URL=https://api.openai.com/v1
# ATLAS_UPSTREAM_API_KEY=
# Required before managed session-end consolidation in non-mock mode. Choose a
# cheap privacy-approved model with reliable JSON; it must not be the chat model.
# ATLAS_CORTEX_UPSTREAM_MODEL=
