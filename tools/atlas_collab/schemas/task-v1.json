{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/collab/task-v1.json",
  "title": "Atlas Collaboration Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "workstream_id",
    "repository",
    "base_ref",
    "base_sha",
    "title",
    "goal",
    "in_scope",
    "out_of_scope",
    "acceptance_criteria",
    "constraints",
    "canonical_context",
    "dependencies",
    "human_gates",
    "requested_roles"
  ],
  "properties": {
    "schema_version": {"const": "atlas.collab.task.v1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,79}$"},
    "workstream_id": {"type": "string", "pattern": "^WS-[0-9]{2,}$"},
    "repository": {"type": "string", "minLength": 3},
    "base_ref": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "minLength": 7},
    "title": {"type": "string", "minLength": 3},
    "goal": {"type": "string", "minLength": 8},
    "in_scope": {"$ref": "#/$defs/stringArray"},
    "out_of_scope": {"$ref": "#/$defs/stringArray"},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "required_evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-[0-9]{2,}$"},
          "text": {"type": "string", "minLength": 8},
          "required_evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "constraints": {"$ref": "#/$defs/stringArray"},
    "canonical_context": {"$ref": "#/$defs/stringArray"},
    "dependencies": {"$ref": "#/$defs/stringArray"},
    "human_gates": {"$ref": "#/$defs/stringArray"},
    "requested_roles": {
      "type": "array",
      "items": {
        "enum": [
          "coordinator",
          "implementer",
          "reviewer",
          "integrator",
          "architecture-security"
        ]
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
